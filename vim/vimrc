" Minimal Vim: built-in features only, no plugin manager.
set nocompatible
set encoding=utf-8
filetype plugin indent on
syntax enable

" Appearance: keep Vim's default colors and the terminal's palette/font.
set number nocursorline
set laststatus=2 ruler showcmd
set shortmess+=I
let &statusline = '%f %h%m%r%=%y %l:%c %p%%'
set scrolloff=5 sidescrolloff=5
set nowrap

" Editing and search.
set backspace=indent,eol,start
set autoindent expandtab tabstop=4 shiftwidth=4 softtabstop=4
set hidden mouse=a
set splitright splitbelow
set ignorecase smartcase incsearch hlsearch
set showmatch matchtime=2
set wildmenu wildmode=longest:full,full
set completeopt=menuone,noselect
set nofoldenable

" Keep recovery files outside projects; preserve symlinks when saving.
for s:dir in ['undo', 'swap', 'backup']
    let s:path = expand('~/.vim/' . s:dir)
    if !isdirectory(s:path)
        call mkdir(s:path, 'p', 0700)
    endif
endfor
set undofile
set undodir=~/.vim/undo//
set directory=~/.vim/swap//
set backupdir=~/.vim/backup//
set backupcopy=yes

" Preserve the most useful shortcuts from the previous configuration.
let mapleader = ' '
nnoremap H ^
nnoremap L $
xnoremap H ^
xnoremap L $
nnoremap <leader><leader> <C-^>
nnoremap <leader>h :nohlsearch<CR>
nnoremap n nzz
nnoremap N Nzz
nnoremap * *zz
nnoremap # #zz
nnoremap <leader>e :Explore<CR>
nnoremap <leader>b :ls<CR>:buffer<Space>

augroup jun_vim
    autocmd!
    autocmd FileType c,cpp,json,javascript,javascriptreact,typescript,typescriptreact setlocal expandtab tabstop=2 shiftwidth=2 softtabstop=2
    autocmd FileType lua,python,solidity setlocal expandtab tabstop=4 shiftwidth=4 softtabstop=4
    autocmd FileType make setlocal noexpandtab tabstop=8 shiftwidth=8 softtabstop=0
    " Restore the previous position, except in commit/rebase messages.
    autocmd BufReadPost *
                \ if &filetype !~# 'commit\|rebase' && line("'\"") > 0 && line("'\"") <= line('$') |
                \     execute "normal! g`\"" |
                \ endif
augroup END
